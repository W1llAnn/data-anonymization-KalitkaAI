# Ключ клиента сервиса (проверяет anongw) — не путать с ключом модели
ANONGW_SERVICE_API_KEY=заменить-на-ключ-сервиса

# Ключ доступа к внешней модели (хранится только внутри сервиса)
ANONGW_MODEL_API_KEY=заменить-на-ключ-модели

# Адрес API внешней модели (по умолчанию — локальная заглушка из compose)
ANONGW_MODEL_BASE_URL=http://localhost:9000

# Хранилище соответствий
ANONGW_MAPPING_DB_PATH=./mapping.db
ANONGW_MAPPING_TTL_HOURS=24

# Ограничение размера inline-файлов, МБ
ANONGW_MAX_FILE_MB=10
